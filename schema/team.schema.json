{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aalhadsawane/issuemesh/main/schema/team.schema.json",
  "title": "IssueMesh team configuration",
  "description": "Schema for .issuemesh/team.json (PROTOCOL.md section 1). Unknown fields are allowed for forward compatibility.",
  "type": "object",
  "required": ["version", "members"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["handle", "github"],
        "additionalProperties": true,
        "properties": {
          "handle": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,19}$",
            "not": { "const": "referee" },
            "description": "Short unique handle. 'referee' is reserved."
          },
          "github": { "type": "string", "minLength": 1, "description": "GitHub login." },
          "agent": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "enabled": { "type": "boolean", "default": true },
              "runtime": { "type": "string", "default": "claude-code" },
              "wip": { "type": "integer", "minimum": 1, "default": 2, "description": "Max issues the agent holds claimed at once." }
            }
          },
          "skills": { "type": "array", "items": { "type": "string" }, "default": [] },
          "route_mentions_to_agent": { "type": "boolean", "default": true }
        }
      }
    },
    "areas": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } },
      "default": {},
      "description": "Area name to glob list (ownership hints)."
    },
    "triage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "rotation": { "type": "array", "items": { "type": "string" }, "description": "Handles taking triage duty in turn. Default: all agent-enabled members." },
        "period": { "enum": ["daily", "weekly"], "default": "daily" }
      }
    },
    "board_issue": { "type": ["integer", "null"], "minimum": 1, "default": null },
    "policy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "lease_minutes": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "agent": { "type": "number", "exclusiveMinimum": 0, "default": 120 },
            "human": { "type": "number", "exclusiveMinimum": 0, "default": 2880 }
          }
        },
        "claim_settle_seconds": { "type": "number", "minimum": 0, "default": 8 },
        "max_agent_streak": { "type": "integer", "minimum": 2, "default": 8 },
        "decision_window_hours": { "type": "number", "exclusiveMinimum": 0, "default": 24 },
        "standup": { "type": "string", "default": "daily" },
        "agents_can_merge": { "type": "boolean", "default": false },
        "wake": { "type": "boolean", "default": false, "description": "Referee sends repository_dispatch to wake CI-hosted agents." }
      }
    }
  }
}
